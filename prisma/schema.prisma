generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================
// MODEL USER (đã mở rộng — thay thế cả Merchant)
// =====================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  role     String  @default("buyer")   // "buyer" | "seller" | "admin"

  // Thông tin shop của seller (null nếu role != "seller")
  shopName        String?
  shopDescription String?
  shopPhone       String?
  shopAddress     String?
  shopStatus      String  @default("PENDING") // "PENDING" | "ACTIVE" | "SUSPENDED"
  shopApprovedAt  DateTime?
  shopCreatedAt   DateTime?

  // Relations
  products          Product[]
  buyerOrders       Customer_order[]     // đơn hàng buyer tạo
  sellerOrderItems  Order_item[]         // items trong đơn seller nhận
  Wishlist          Wishlist[]
  notifications     Notification[]
  bulkUploadBatches bulk_upload_batch[]  @relation("UserBatches")
  reviews          Review[]              @relation("UserReviews")

  @@index([role])
  @@index([shopStatus])
}

// =====================
// MODEL PRODUCT (đổi merchantId -> sellerId)
// =====================
model Product {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  mainImage    String
  price        Int      @default(0)
  rating       Int      @default(0)
  description  String
  manufacturer String
  inStock      Int      @default(1)
  status       String   @default("DRAFT")  // DRAFT, PUBLISHED, ARCHIVED
  categoryId   String
  sellerId     String   // ← đổi từ merchantId

  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seller          User              @relation(fields: [sellerId], references: [id])
  orderItems     Order_item[]
  Wishlist       Wishlist[]
  reviews        Review[]
  subOrderProducts SubOrderProduct[]
  bulkUploadItems bulk_upload_item[] @relation("ProductBulkItems")

  @@index([categoryId])
  @@index([sellerId])
  @@index([price])
  @@index([rating])
  @@index([inStock])
  @@index([status])
  @@index([manufacturer])
  @@index([categoryId, price])
  @@index([categoryId, rating])
  @@index([sellerId, status])
  @@index([status, inStock])
}

model Image {
  imageID   String @id @default(uuid())
  productID String
  image     String

  @@index([productID])
}

// =====================
// MODEL ORDER (thêm buyerId)
// =====================
model Customer_order {
  id         String   @id @default(uuid())
  buyerId    String?  // null nếu checkout không đăng nhập

  name       String
  lastname   String
  phone      String
  email      String
  company    String?
  adress     String
  apartment  String?
  postalCode String
  city       String
  country    String
  orderNotice String?
  dateTime   DateTime @default(now())
  status     String   @default("processing") // "processing"|"delivered"|"canceled"
  total      Int

  buyer User?        @relation(fields: [buyerId], references: [id])
  items Order_item[]
  payments Payment[]
  subOrders SubOrder[]

  @@index([email])
  @@index([buyerId])
  @@index([status])
  @@index([dateTime])
  @@index([status, dateTime])
  @@index([dateTime, status])
}

// =====================
// MODEL MERCHANT (legacy - sellers now use User.shop fields)
// Kept for backward compatibility with existing routes/controllers
// Note: New products should use Product.sellerId -> User.id
// =====================
model Merchant {
  id           String  @id @default(uuid())
  name         String
  description  String?
  email        String?
  phone        String?
  address      String?
  status       String  @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  shippingFee  Int     @default(0)
  avatar       String?
  banner       String?

  // Relations
  vouchers Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// =====================
// MODEL VOUCHER
// =====================
model Voucher {
  id             String    @id @default(uuid())
  code           String    @unique
  title          String
  description    String?
  discountType   String    // PERCENTAGE, FIXED
  discountValue  Int        // % (1-100) hoặc số tiền (cents)
  merchantId     String?
  merchant       Merchant?  @relation(fields: [merchantId], references: [id])
  minOrderValue  Int?       // Số tiền tối thiểu (cents)
  maxDiscount   Int?       // Giảm tối đa (cents)
  usageLimit    Int?
  usedCount     Int        @default(0)
  perUserLimit  Int        @default(1)
  startsAt      DateTime  @default(now())
  expiresAt     DateTime
  isActive      Boolean   @default(true)

  usages VoucherUsage[]

  @@index([code])
  @@index([merchantId])
  @@index([isActive])
  @@index([expiresAt])
}

// =====================
// MODEL VOUCHER_USAGE
// =====================
model VoucherUsage {
  id        String   @id @default(uuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  userId    String?
  orderId   String?
  usedAt    DateTime @default(now())

  @@index([voucherId])
  @@index([userId])
}

// =====================
// MODEL PAYMENT
// =====================
model Payment {
  id        String   @id @default(uuid())
  orderId   String
  customer_order Customer_order @relation(fields: [orderId], references: [id])
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  method    String?  // CARD, BANK_TRANSFER, COD
  amount    Int      @default(0)
  paidAt    DateTime?

  @@index([orderId])
  @@index([status])
}

// =====================
// MODEL REVIEW
// =====================
model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1-5 stars
  comment   String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserReviews", fields: [userId], references: [id])
  merchantId String
  orderId   String?
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN, FLAGGED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([merchantId])
  @@index([userId])
  @@index([rating])
}

// =====================
// MODEL SUB_ORDER (legacy - for backward compatibility)
// Note: New orders should use Customer_order + Order_item
// =====================
model SubOrder {
  id              String   @id @default(uuid())
  parentOrderId   String
  parentOrder     Customer_order @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  merchantId      String
  status          String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  subTotal        Int      @default(0)
  shippingTotal   Int      @default(0)
  trackingNumber  String?
  shippingProvider String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  products SubOrderProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentOrderId])
  @@index([merchantId])
  @@index([status])
}

// =====================
// MODEL SUB_ORDER_PRODUCT (legacy - for backward compatibility)
// Note: New orders should use Customer_order + Order_item
// =====================
model SubOrderProduct {
  id                    String   @id @default(uuid())
  subOrderId           String
  subOrder             SubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product   @relation(fields: [productId], references: [id])
  quantity             Int
  productNameSnapshot  String
  productImageSnapshot String?
  unitPriceSnapshot    Int
  merchantIdSnapshot   String
  merchantNameSnapshot String

  @@index([subOrderId])
  @@index([productId])
}

// =====================
// MODEL ORDER_ITEM (thay thế customer_order_product)
// Lý do: cần biết item này của seller nào để seller tự xem đơn của mình
// =====================
model Order_item {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  sellerId        String  // ← quan trọng nhất
  quantity        Int
  priceAtPurchase Int     // lưu giá tại thời điểm mua, tránh thay đổi giá sau

  order   Customer_order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  seller  User           @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Wishlist {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([productId, userId])
  @@index([userId])
  @@index([productId])
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_STATUS
  PROMOTION
  SYSTEM_ALERT
  NEW_ORDER       // ← thêm: thông báo cho seller khi có đơn mới
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String               @db.Text
  type      NotificationType
  isRead    Boolean              @default(false)
  priority  NotificationPriority @default(NORMAL)
  metadata  Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
  @@index([createdAt])
}

model bulk_upload_batch {
  id         String           @id @default(uuid())
  fileName   String?
  createdAt  DateTime         @default(now())
  status     BulkUploadStatus @default(PENDING)
  itemCount  Int              @default(0)
  errorCount Int              @default(0)
  items      bulk_upload_item[]

  userId String?
  user   User?   @relation(name: "UserBatches", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model bulk_upload_item {
  id      String            @id @default(uuid())
  batchId String
  batch   bulk_upload_batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(name: "ProductBulkItems", fields: [productId], references: [id], onDelete: SetNull)

  title        String
  slug         String
  price        Int
  manufacturer String?
  description  String?
  mainImage    String?
  categoryId   String
  inStock      Int

  status BulkUploadItemStatus @default(CREATED)
  error  String?

  @@index([batchId])
  @@index([productId])
  @@index([status])
}

enum BulkUploadStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
}

enum BulkUploadItemStatus {
  CREATED
  UPDATED
  ERROR
}
